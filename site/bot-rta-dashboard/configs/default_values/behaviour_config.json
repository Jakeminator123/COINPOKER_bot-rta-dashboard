{
  "_meta": {
    "version": "2.0.0",
    "description": "Configuration for detecting bot-like input patterns (mouse/keyboard behavior analysis)"
  },
  "_points_mapping": {
    "0": {
      "status": "INFO",
      "description": "Unusual but not threatening (score 15-24)"
    },
    "5": {
      "status": "WARN",
      "description": "Suspicious patterns detected (score 25-44)"
    },
    "10": {
      "status": "ALERT",
      "description": "Likely bot behavior (score 45-69)"
    },
    "15": {
      "status": "CRITICAL",
      "description": "Definite bot patterns (score 70+)"
    }
  },
  "detection_points": {
    "_description": "Threat points based on bot score (0-100). Higher score = more bot-like.",
    "score_15_24": 0,
    "score_25_44": 5,
    "score_45_69": 10,
    "score_70_plus": 15
  },
  "data_collection": {
    "_description": "How often and how much input data to collect",
    "polling_frequency_hz": 239,
    "analysis_window_seconds": 20,
    "min_mouse_movement_px": 6,
    "jitter_threshold_px": 1.5,
    "jitter_window_seconds": 0.3
  },
  "polling": {
    "frequency_hz": 239,
    "window_seconds": 20,
    "min_move_px": 6,
    "jitter_px_threshold": 1.5,
    "jitter_window": 0.3
  },
  "bot_detection_thresholds": {
    "_description": "Thresholds for detecting bot-like behavior. Lower values = stricter detection.",
    "keyboard_timing": {
      "_description": "Inter-Keystroke Interval (IKI) coefficient of variation thresholds",
      "cv_critical": 0.07,
      "cv_suspicious": 0.10,
      "_human_typical": "Humans typically have CV > 0.20 (20% variation in typing speed)"
    },
    "click_timing": {
      "_description": "Inter-Click Interval (ICI) coefficient of variation thresholds",
      "cv_critical": 0.07,
      "cv_suspicious": 0.10,
      "_human_typical": "Humans typically have CV > 0.20 (20% variation in click timing)"
    },
    "mouse_movement": {
      "_description": "Mouse movement pattern thresholds",
      "constant_velocity_critical": 0.75,
      "constant_velocity_suspicious": 0.50,
      "constant_velocity_tolerance": 0.10,
      "straight_line_critical": 0.045,
      "straight_line_suspicious": 0.09,
      "_explanation": "constant_velocity = fraction of movements with same speed. straight_line = direction variability (lower = straighter)"
    },
    "reaction_time": {
      "_description": "Minimum human reaction time in milliseconds",
      "min_reaction_ms": 140,
      "_explanation": "Reactions faster than 140ms are physically impossible for humans"
    },
    "click_position": {
      "_description": "Repeated pixel click detection",
      "pixel_radius_px": 2,
      "repeat_threshold": 3,
      "repeat_fraction": 0.30,
      "_explanation": "Bots often click exact same pixels repeatedly. Humans have natural variance."
    },
    "jitter": {
      "_description": "Micro-movement (jitter) analysis",
      "rms_critical": 0.25,
      "_explanation": "Humans have natural hand tremor. Very low jitter suggests synthetic input."
    }
  },
  "thresholds": {
    "iki_cv_alert": 0.07,
    "iki_cv_warn": 0.1,
    "ici_cv_alert": 0.07,
    "ici_cv_warn": 0.1,
    "const_velocity_alert": 0.75,
    "const_velocity_warn": 0.5,
    "const_velocity_tolerance": 0.1,
    "dir_variability_alert": 0.045,
    "dir_variability_warn": 0.09,
    "min_reaction_ms": 140,
    "repeated_pixel_radius_px": 2,
    "repeated_pixel_threshold": 3,
    "repeated_pixel_fraction": 0.3,
    "jitter_rms_alert": 0.25
  },
  "scoring_weights": {
    "_description": "How many points each detection adds to the bot score (max 100)",
    "keyboard": {
      "very_consistent_timing": 12,
      "consistent_timing": 6
    },
    "click": {
      "very_consistent_timing": 12,
      "consistent_timing": 6
    },
    "mouse": {
      "constant_velocity_high": 20,
      "constant_velocity_medium": 10,
      "very_straight_paths": 12,
      "straight_paths": 6,
      "repeated_pixels": 12,
      "no_jitter": 0
    },
    "reaction": {
      "superhuman_speed": 10
    }
  },
  "scoring_weights_flat": {
    "iki_very_low_variance": 12,
    "iki_low_variance": 6,
    "ici_very_low_variance": 12,
    "ici_low_variance": 6,
    "constant_velocity_high": 20,
    "constant_velocity_medium": 10,
    "direction_very_straight": 12,
    "direction_straight": 6,
    "repeated_pixels": 12,
    "low_jitter": 0,
    "too_fast_reactions": 10
  },
  "reporting": {
    "_description": "How often to report detections",
    "cooldown_seconds": 30,
    "analysis_interval_seconds": 20,
    "min_input_events": 20,
    "keepalive_seconds": 45,
    "keepalive_timeout": 90
    ,
    "report_cooldown_s": 30,
    "interval_s": 20,
    "min_events_threshold": 20
  }
}
